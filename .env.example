# Kratos Frontend Environment Configuration

# ===========================================
# API Configuration
# ===========================================

# Base URL for the Kratos API
# Default: https://kratos-api.local.fintech23.xyz
VITE_API_URL=https://kratos-api.local.fintech23.xyz

# API request timeout in milliseconds
# Default: 30000 (30 seconds)
VITE_API_TIMEOUT=30000

# Number of retry attempts for failed requests
# Default: 3
VITE_API_RETRY_ATTEMPTS=3

# Delay between retry attempts in milliseconds
# Default: 1000 (1 second)
VITE_API_RETRY_DELAY=1000

# ===========================================
# Feature Flags
# ===========================================

# Use mock data instead of real API calls
# Set to 'true' during development if API is not available
# Default: false
VITE_USE_MOCK=false

# Enable debug logging in development
# Default: true
VITE_DEBUG_LOGGING=true

# Enable React DevTools
# Default: true in development
VITE_ENABLE_DEVTOOLS=true

# ===========================================
# Authentication Configuration
# ===========================================

# Token refresh warning threshold in minutes
# Show warning when token expires within this time
# Default: 5
VITE_TOKEN_REFRESH_WARNING_MINUTES=5

# Auto-refresh token threshold in minutes
# Automatically refresh token when it expires within this time
# Default: 10
VITE_TOKEN_AUTO_REFRESH_MINUTES=10

# ===========================================
# Application Configuration
# ===========================================

# Application title shown in browser tab
VITE_APP_TITLE=Kratos Workflow Management

# Application version (auto-populated from package.json if not set)
VITE_APP_VERSION=

# Default theme ('light' or 'dark' or 'system')
# Default: system
VITE_DEFAULT_THEME=system

# Maximum file upload size in MB
# Default: 10
VITE_MAX_FILE_UPLOAD_SIZE=10

# ===========================================
# Development Configuration
# ===========================================

# Enable hot module replacement
# Default: true in development
VITE_HMR=true

# Development server port
# Default: 5173
VITE_DEV_PORT=5173

# Development server host
# Default: localhost
VITE_DEV_HOST=localhost

# ===========================================
# Analytics and Monitoring
# ===========================================

# Enable error tracking (e.g., Sentry DSN)
VITE_ERROR_TRACKING_DSN=

# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false

# Analytics tracking ID
VITE_ANALYTICS_ID=

# ===========================================
# Security Configuration
# ===========================================

# Enable HTTPS enforcement in production
# Default: true
VITE_ENFORCE_HTTPS=true

# Content Security Policy report endpoint
VITE_CSP_REPORT_URI=

# ===========================================
# Performance Configuration
# ===========================================

# Enable service worker for caching
# Default: true in production
VITE_ENABLE_SERVICE_WORKER=true

# Enable bundle analyzer
# Default: false
VITE_ANALYZE_BUNDLE=false

# ===========================================
# Internationalization
# ===========================================

# Default language
# Default: en
VITE_DEFAULT_LANGUAGE=en

# Available languages (comma-separated)
# Default: en
VITE_AVAILABLE_LANGUAGES=en

# ===========================================
# Third-party Integrations
# ===========================================

# File storage service configuration
VITE_FILE_STORAGE_PROVIDER=local
VITE_FILE_STORAGE_BUCKET=
VITE_FILE_STORAGE_REGION=

# Email service configuration
VITE_EMAIL_SERVICE_PROVIDER=
VITE_EMAIL_SERVICE_API_KEY=

# Notification service configuration
VITE_NOTIFICATION_SERVICE_URL=
VITE_NOTIFICATION_SERVICE_KEY=