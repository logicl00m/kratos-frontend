      "Bash(if ! grep -q \"\\.dark \" \"$file\")",
      "Bash(then)",
      "Bash(echo \"$file\")",
      "Bash(fi)",
      "Bash(done)",
      "Bash(xargs:*)",
      "Bash(while read comp)",
      "Bash(do if [ ! -f \"src/features/application-details/components/$comp.css\" ])",
      "Bash(then echo \"$comp - No CSS\")"
    ],
    "deny": [],
    "ask": []
  }
