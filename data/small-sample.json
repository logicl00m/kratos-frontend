{
    "workflow": {
        "id": "loan_workflow_v1",
        "version": 1,
        "initialState": "armDraft",
        "forms": {
            "coreDetails": {
                "fields": [
                    {
                        "id": "applicantLegalName",
                        "name": "Applicant Legal Name",
                        "type": "text",
                        "status": "default",
                        "data": "{{ data.borrower.legalName }}",
                        "fieldActions": [
                            "save",
                            "validate"
                        ]
                    },
                    {
                        "id": "requestedAmount",
                        "name": "Requested Amount",
                        "type": "number",
                        "status": "default",
                        "data": "{{ data.facility.requestedAmount }}",
                        "fieldActions": [
                            "save",
                            "validate"
                        ]
                    },
                    {
                        "id": "proposalDetails",
                        "name": "Proposal Details",
                        "type": "textarea",
                        "status": "default",
                        "data": "{{ data.proposal.details }}",
                        "fieldActions": [
                            "save",
                            "validate"
                        ]
                    },
                    {
                        "id": "supportingDocuments",
                        "name": "Supporting Documents",
                        "type": "file",
                        "status": "default",
                        "data": "{{ data.documents }}",
                        "fieldActions": [
                            "upload",
                            "replace",
                            "validate"
                        ]
                    }
                ]
            },
            "reviewOutputs": {
                "fields": [
                    {
                        "id": "rmDecision",
                        "name": "RM Decision",
                        "type": "select",
                        "status": "default",
                        "data": "{{ data.rm.decision }}",
                        "fieldActions": [
                            "validate"
                        ]
                    },
                    {
                        "id": "finalMemo",
                        "name": "Credit Memo",
                        "type": "file",
                        "status": "default",
                        "data": "{{ data.outputs.creditMemo }}",
                        "fieldActions": [
                            "download"
                        ]
                    }
                ]
            }
        },
        "states": {
            "armDraft": {
                "name": "ARM Draft",
                "forms": [
                    {
                        "formName": "coreDetails"
                    }
                ],
                "actions": {
                    "submitToRm": {
                        "nextState": "rmReview",
                        "operation": "Validate draft; save; notify RM"
                    }
                }
            },
            "rmReview": {
                "name": "RM Review",
                "forms": [
                    {
                        "formName": "coreDetails"
                    },
                    {
                        "formName": "reviewOutputs"
                    }
                ],
                "actions": {
                    "rmReject": {
                        "nextState": "armDraft",
                        "operation": "Return to ARM with fields to correct"
                    },
                    "rmFinalize": {
                        "nextState": "completed",
                        "operation": "Finalize proposal"
                    }
                }
            },
            "completed": {
                "name": "Completed",
                "forms": [
                    {
                        "formName": "coreDetails"
                    },
                    {
                        "formName": "reviewOutputs"
                    }
                ],
                "actions": {}
            }
        }
    }
}